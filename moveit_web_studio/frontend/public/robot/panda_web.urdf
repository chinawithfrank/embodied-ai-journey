  <link name="panda_link3"><visual><origin xyz="0 0 0.14"/><geometry><cylinder radius="0.045" length="0.28"/></geometry><material name="white"><color rgba="0.75 0.8 0.84 1"/></material></visual></link>
  <link name="panda_link4"><visual><origin xyz="0 0 0.12"/><geometry><cylinder radius="0.04" length="0.24"/></geometry><material name="white"><color rgba="0.75 0.8 0.84 1"/></material></visual></link>
