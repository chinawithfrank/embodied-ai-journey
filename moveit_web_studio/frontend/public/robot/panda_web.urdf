<?xml version="1.0"?>
<robot name="panda_web">
  <link name="panda_link0"><visual><geometry><cylinder radius="0.09" length="0.16"/></geometry><material name="dark"><color rgba="0.12 0.15 0.18 1"/></material></visual></link>
  <link name="panda_link1"><visual><origin xyz="0 0 0.17"/><geometry><cylinder radius="0.055" length="0.34"/></geometry><material name="white"><color rgba="0.75 0.8 0.84 1"/></material></visual></link>
