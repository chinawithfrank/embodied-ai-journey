  <link name="panda_hand"><visual><origin xyz="0 0 0.05"/><geometry><box size="0.1 0.08 0.1"/></geometry><material name="hand"><color rgba="0.2 0.23 0.28 1"/></material></visual></link>
  <joint name="panda_joint1" type="revolute"><parent link="panda_link0"/><child link="panda_link1"/><axis xyz="0 0 1"/><limit lower="-2.9" upper="2.9" effort="1" velocity="1"/></joint>
  <joint name="panda_joint2" type="revolute"><parent link="panda_link1"/><child link="panda_link2"/><origin xyz="0 0 0.34"/><axis xyz="0 1 0"/><limit lower="-2.9" upper="2.9" effort="1" velocity="1"/></joint>
  <joint name="panda_joint3" type="revolute"><parent link="panda_link2"/><child link="panda_link3"/><origin xyz="0 0 0.32"/><axis xyz="0 1 0"/><limit lower="-2.9" upper="2.9" effort="1" velocity="1"/></joint>
  <joint name="panda_joint4" type="revolute"><parent link="panda_link3"/><child link="panda_link4"/><origin xyz="0 0 0.28"/><axis xyz="1 0 0"/><limit lower="-2.9" upper="2.9" effort="1" velocity="1"/></joint>
  <joint name="panda_joint5" type="revolute"><parent link="panda_link4"/><child link="panda_link5"/><origin xyz="0 0 0.24"/><axis xyz="0 1 0"/><limit lower="-2.9" upper="2.9" effort="1" velocity="1"/></joint>
  <joint name="panda_joint6" type="revolute"><parent link="panda_link5"/><child link="panda_link6"/><origin xyz="0 0 0.2"/><axis xyz="1 0 0"/><limit lower="-2.9" upper="2.9" effort="1" velocity="1"/></joint>
  <joint name="panda_joint7" type="revolute"><parent link="panda_link6"/><child link="panda_link7"/><origin xyz="0 0 0.16"/><axis xyz="0 1 0"/><limit lower="-2.9" upper="2.9" effort="1" velocity="1"/></joint>
