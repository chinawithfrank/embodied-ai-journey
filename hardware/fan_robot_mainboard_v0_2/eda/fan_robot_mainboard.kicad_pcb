			(layer "In1.Cu"
				(type "copper")
				(thickness 0.0175)
			)
			(layer "dielectric 2"
				(type "core")
				(thickness 1.095)
				(material "FR4")
				(epsilon_r 4.6)
				(loss_tangent 0.02)
